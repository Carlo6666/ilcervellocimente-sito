        {
          "start": 8.88,
          "end": 13.76,
          "text": "Kennst du das, wenn du etwas tust und dich kurz darauf fragst, warum habe ich das getan?"
        },
        {
          "start": 13.76,
          "end": 16.0,
          "text": "Herzlich Willkommen."
        },
        {
          "start": 16.0,
          "end": 18.48,
          "text": "Du bist hier genau richtig."
        },
        {
          "start": 18.48,
          "end": 19.48,
          "text": "Ich bin Nora."
        },
        {
          "start": 19.48,
          "end": 24.28,
          "text": "Ich habe ein ganz normales Leben, ein Büro, einen Partner, eine Kollegin, die ständig"
        },
        {
          "start": 24.28,
          "end": 28.04,
          "text": "Fenchel kaut und ein Gehirn, das für mich arbeitet."
        },
        {
          "start": 28.04,
          "end": 33.84,
          "text": "Auf seine Weise, denn das Gehirn zeigt uns die Welt nicht so, wie sie ist."
        },
        {
          "start": 33.84,
          "end": 38.64,
          "text": "Es erzählt sie uns, rät, sagt voraus, füllt Lücken mit dem, was es schon erlebt"
        },
        {
          "start": 38.64,
          "end": 39.96,
          "text": "hat."
        },
        {
          "start": 39.96,
          "end": 42.52,
          "text": "Fast immer leistet es dabei hervorragende Arbeit."
        },
        {
          "start": 42.52,
          "end": 47.72,
          "text": "Manchmal lässt es mich um 11 Uhr 46 abends einen Mantel kaufen."
        },
        {
          "start": 47.72,
          "end": 50.16,
          "text": "Hier erzähle ich dir in Episoden aus meinem Leben."
        },
        {
          "start": 50.16,
          "end": 53.32,
          "text": "Peinlichkeiten, Panik, Streit um den Konferenzraum."
        },
        {
          "start": 53.32,
          "end": 59.16,
          "text": "Dann fragen wir Experten, die das Gehirn erforschen, warum wir so denken, wählen und reagieren."
        },
        {
          "start": 59.16,
          "end": 64.0,
          "text": "Und am Ende gibt es drei einfache Schritte, um seltener darauf reinzufallen."
        },
        {
          "start": 64.0,
          "end": 65.48,
          "text": "Meine Geschichten sind erfunden."
        },
        {
          "start": 66.12,
          "end": 69.36,
          "text": "Die Erklärungen nicht, ich nenne dir immer die Quellen."
        },
        {
          "start": 69.36,
          "end": 71.04,
          "text": "Alles basiert auf einem Buch."
        },
        {
          "start": 71.04,
          "end": 73.24,
          "text": "Unser Gehirn belügt uns."
        },
        {
          "start": 73.24,
          "end": 75.88,
          "text": "Es erscheint in Kürze, folge mir."
        },
        {
          "start": 75.88,
          "end": 78.88,
          "text": "Die erste Folge beginnt mit einer Nachricht."
        },
        {
          "start": 78.88,
          "end": 82.52,
          "text": "Drei Worte und ein Ausrufezeichen."
        },
        {
          "start": 82.52,
          "end": 86.68,
